{
  "id": null,
  "title": "Data Platform Overview",
  "tags": [
    "overview",
    "data-platform",
    "sre",
    "health"
  ],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "hideControls": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Platform Health Status",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=~\"postgres-exporter|kafka-exporter|node-exporter|prometheus\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Data Ingestion Pipeline Status",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(dlt_pipeline_runs_total[5m])",
          "legendFormat": "Pipeline Runs/min",
          "refId": "A"
        },
        {
          "expr": "rate(dlt_pipeline_runs_failed_total[5m])",
          "legendFormat": "Failed Runs/min",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "yAxes": [
        {
          "label": "Runs per minute",
          "min": 0
        },
        {
          "show": false
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ],
      "legend": {
        "show": true
      }
    },
    {
      "id": 3,
      "title": "Kafka Topic Messages",
      "type": "graph",
      "targets": [
        {
          "expr": "kafka_topic_partition_current_offset",
          "legendFormat": "{{topic}} - Partition {{partition}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "yAxes": [
        {
          "label": "Messages",
          "min": 0
        },
        {
          "show": false
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ],
      "legend": {
        "show": true
      }
    },
    {
      "id": 4,
      "title": "PostgreSQL Database Stats",
      "type": "graph",
      "targets": [
        {
          "expr": "pg_stat_database_tup_inserted{datname!=\"template0\",datname!=\"template1\"}",
          "legendFormat": "Inserts - {{datname}}",
          "refId": "A"
        },
        {
          "expr": "pg_stat_database_tup_updated{datname!=\"template0\",datname!=\"template1\"}",
          "legendFormat": "Updates - {{datname}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "yAxes": [
        {
          "label": "Operations",
          "min": 0
        },
        {
          "show": false
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ],
      "legend": {
        "show": true
      }
    },
    {
      "id": 5,
      "title": "System Resource Usage",
      "type": "graph",
      "targets": [
        {
          "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU Usage % - {{instance}}",
          "refId": "A"
        },
        {
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
          "legendFormat": "Memory Usage % - {{instance}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "yAxes": [
        {
          "label": "Percentage",
          "min": 0,
          "max": 100
        },
        {
          "show": false
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ],
      "legend": {
        "show": true
      }
    },
    {
      "id": 6,
      "title": "Container Resource Usage",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{name=~\"silism-.*\"}[5m]) * 100",
          "legendFormat": "CPU % - {{name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "yAxes": [
        {
          "label": "CPU Percentage",
          "min": 0
        },
        {
          "show": false
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ],
      "legend": {
        "show": true
      }
    },
    {
      "id": 7,
      "title": "Container Memory Usage",
      "type": "graph",
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"silism-.*\"} / 1024 / 1024",
          "legendFormat": "Memory MB - {{name}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "yAxes": [
        {
          "label": "Memory (MB)",
          "min": 0
        },
        {
          "show": false
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ],
      "legend": {
        "show": true
      }
    },
    {
      "id": 8,
      "title": "Business Metrics Health",
      "type": "stat",
      "targets": [
        {
          "expr": "revenue_today",
          "legendFormat": "Today's Revenue",
          "refId": "A"
        },
        {
          "expr": "orders_per_hour",
          "legendFormat": "Orders/Hour",
          "refId": "B"
        },
        {
          "expr": "active_customers_today",
          "legendFormat": "Active Customers",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    }
  ]
}