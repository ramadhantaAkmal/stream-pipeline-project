{
  "id": null,
  "title": "Docker Container Monitoring",
  "tags": [
    "container",
    "ai",
    "analytics",
    "llm"
  ],
  "style": "dark",
  "timezone": "browser",
  "editable": true,
  "hideControls": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Container Monitoring Status",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=\"cadvisor\"}",
          "legendFormat": "cAdvisor Status",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Total Container CPU Usage",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{id!=\"/\",id!=\"/docker\"}[5m])) * 100",
          "legendFormat": "Total CPU %",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          },
          "unit": "percent"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Total Container Memory Usage",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{id!=\"/\",id!=\"/docker\"}) / 1024 / 1024",
          "legendFormat": "Total Memory MB",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "decbytes"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Running Containers",
      "type": "stat",
      "targets": [
        {
          "expr": "count(container_start_time_seconds{id!=\"/\",id!=\"/docker\"})",
          "legendFormat": "Container Count",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Container CPU Usage Over Time",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{id!=\"/\",id!=\"/docker\"}[5m]) * 100",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "yAxes": [
        {
          "label": "CPU Usage %",
          "min": 0
        },
        {
          "show": false
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true,
        "avg": true
      }
    },
    {
      "id": 6,
      "title": "Container Memory Usage Over Time",
      "type": "graph",
      "targets": [
        {
          "expr": "container_memory_usage_bytes{id!=\"/\",id!=\"/docker\"} / 1024 / 1024",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "yAxes": [
        {
          "label": "Memory (MB)",
          "min": 0
        },
        {
          "show": false
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ],
      "legend": {
        "show": true,
        "values": true,
        "current": true,
        "avg": true
      }
    },
    {
      "id": 7,
      "title": "Network I/O",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{id!=\"/\",id!=\"/docker\"}[5m])",
          "legendFormat": "RX - {{id}}",
          "refId": "A"
        },
        {
          "expr": "rate(container_network_transmit_bytes_total{id!=\"/\",id!=\"/docker\"}[5m])",
          "legendFormat": "TX - {{id}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "yAxes": [
        {
          "label": "Bytes/sec",
          "min": 0
        },
        {
          "show": false
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ],
      "legend": {
        "show": true
      }
    },
    {
      "id": 8,
      "title": "Disk I/O",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(container_fs_reads_bytes_total{id!=\"/\",id!=\"/docker\"}[5m])",
          "legendFormat": "Read - {{id}}",
          "refId": "A"
        },
        {
          "expr": "rate(container_fs_writes_bytes_total{id!=\"/\",id!=\"/docker\"}[5m])",
          "legendFormat": "Write - {{id}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "yAxes": [
        {
          "label": "Bytes/sec",
          "min": 0
        },
        {
          "show": false
        }
      ],
      "xAxes": [
        {
          "show": true,
          "mode": "time"
        }
      ],
      "legend": {
        "show": true
      }
    }
  ]
}